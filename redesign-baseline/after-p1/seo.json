          },
          {
            "@type": "ListItem",
            "position": 3,
            "name": "FAQ",
            "item": "https://www.davistent.com/support/faq/"
          }
        ]
      },
      {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        "mainEntity": [
          {
            "@type": "Question",
            "name": "What size tent do I need?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Allow room for cots, a stove and an eating area. If you are between sizes, size up. Our sizing guide lists how many each tent sleeps."
            }
          },
          {
            "@type": "Question",
            "name": "Do your tents come with a frame?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "No. Frames are sold separately. A 14' × 15' tent needs 17 sticks of 1\" EMT in 10' lengths; the Go Tent needs 9. You can order angles only with a cut list and buy EMT locally to save freight."
            }
          },
          {
            "@type": "Question",
            "name": "Internal frame or traditional poles?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Internal frames suit long-term setups. Traditional poles pack smaller and weigh about half as much, and can be packed on horseback."
            }
          },
          {
            "@type": "Question",
            "name": "What is a sod cloth?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "A band of material sewn in around the inside bottom of the tent that keeps drafts and snow out. Our standard sod cloth is 10\"; the FAQ also mentions 10\" to 15\" vinyl."
            }
          },
          {
            "@type": "Question",
            "name": "Why don’t you include a tent bag?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Canvas bags let food odours out and invite mice into stored tents. A hard container is recommended for storage."
            }
          },
          {
            "@type": "Question",
            "name": "How do I care for and store my tent?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Let it dry for about 48–72 hours before storage. Clean with mild soap and a soft brush. Store in a hard container."
            }
          },
          {
            "@type": "Question",
            "name": "Can you make a custom size?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Yes. Tents over 320 sq ft are $2.95 per sq ft (water and mildew) or $3.63 per sq ft (water, mildew and fire). For anything larger than 16' × 25', call us for a quote."
            }
          },
          {
            "@type": "Question",
            "name": "Do you repair tents?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Yes. Patches are sewn on scheduled repair days once 25 to 35 tents have accumulated. We do not take repairs during hunting season. A patch kit handles small holes."
            }
          },
          {
            "@type": "Question",
            "name": "Which stove fits my tent?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Valley fits 12' × 15' and smaller; Ridge fits 12' × 15' to 14' × 15'; Peak fits 14' × 15' and larger. All need a 5.5\" or larger stove jack."
            }
          },
          {
            "@type": "Question",
            "name": "Do I need to pre-burn my stove?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Yes. Be sure to pre-burn your stove prior to placing it in your tent."
            }
          },
          {
            "@type": "Question",
            "name": "Where are you located?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Our shop is at 4230 Broadway Street, Denver, CO 80216. Shop and showroom tours are offered; call ahead to arrange a visit."
            }
          },
          {
            "@type": "Question",
            "name": "Can you ship to every state?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "We cannot ship tents to CA, LA, MA, MI, MN, NY, NJ or Canada without the FIRE treatment."
            }
          }
        ]
