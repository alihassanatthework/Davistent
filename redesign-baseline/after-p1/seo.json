  "/support/faq/": {
    "title": "Frequently Asked Questions | Davis Tent",
    "description": "Answers about Davis wall tents, camp stoves, custom sizes, repairs, shipping and visiting our Denver shop.",
    "canonical": "https://www.davistent.com/support/faq/",
    "h1": [
      "Frequently Asked Questions"
    ],
    "jsonLd": [
      {
        "@context": "https://schema.org",
